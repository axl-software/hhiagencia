# Copia este archivo como .env.local y completa los valores.
# Están en Supabase → Project Settings → API (o en el botón "Connect" del proyecto).
# En Vercel van en Settings → Environment Variables, con los mismos nombres.
# Usa la clave "publishable" (pública). NUNCA la "secret key" ni la "service_role".
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: Google Analytics 4 y Google Search Console (NEXT_PUBLIC_ = se ven en el navegador, son datos públicos).
# GA_ID: ID de medición de GA4 (Admin → Flujos de datos → tu sitio web; empieza con G-).
# GSC_VERIFICACION: solo el código de la etiqueta HTML de Search Console (el valor de content="...").
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICACION=

# Opcional: respuesta automática. URL del webhook del flujo (por ejemplo, n8n) que recibe cada
# solicitud guardada, y una clave secreta que el flujo puede comprobar (encabezado x-hha-secreto).
# Van SOLO en .env.local y en Vercel (no llevan NEXT_PUBLIC_, no se ven en el navegador).
SOLICITUDES_WEBHOOK_URL=
SOLICITUDES_WEBHOOK_SECRETO=
