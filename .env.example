# Copia este archivo como .env.local y completa los valores.
# Están en Supabase → Project Settings → API (o en el botón "Connect" del proyecto).
# En Vercel van en Settings → Environment Variables, con los mismos nombres.
# Usa la clave "publishable" (pública). NUNCA la "secret key" ni la "service_role".
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
